{
  "name": "proshop-v2",
  "version": "1.0.0",
  "description": "eCommerse MERN stack app",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "npm start --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "data:import": "node backend/seeder.js",
    "data:destroy": "node backend/seeder.js -d"
  },
  "author": "Aswathi Mohan",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "colors": "^1.4.0",
    "express": "^5.2.1",
    "mongoose": "^9.10.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.4",
    "nodemon": "^3.1.14"
  }
}
